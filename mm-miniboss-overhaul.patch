+        if (!Eo_FindFloor(play, &pos, 150.0f, &floorY)) {
+            pos = this->actor.world.pos;
+        } else {
+            pos.y = floorY;
+        }
+        EoSummon_Spawn(play, &this->actor, ACTOR_EN_JSO, &pos, yaw + 0x8000, EN_JSO_PARAMS_SUMMONED);
