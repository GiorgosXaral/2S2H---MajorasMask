diff --git a/mm/2s2h/Enhancements/EnemyOverhaul/EnemyOverhaul.h b/mm/2s2h/Enhancements/EnemyOverhaul/EnemyOverhaul.h
new file mode 100644
index 000000000..18164dc1a
--- /dev/null
+++ b/mm/2s2h/Enhancements/EnemyOverhaul/EnemyOverhaul.h
@@ -0,0 +1,32 @@
+#ifndef ENEMY_OVERHAUL_H
+#define ENEMY_OVERHAUL_H
+
+/**
+ * Enemy Overhaul (Enhancements > Difficulty Options > Enemy Overhaul)
+ *
+ * A lighter pass over the game's common enemies and random encounters: Big Octo, Black and White Boe, Dinolfos,
+ * Eeno, White Wolfos, Death Armos, ReDead, Gibdo and the Poe Sisters. Unlike Miniboss/Boss Overhaul this is not a
+ * flat multiplier - each enemy got whatever mix of more health, shorter downtime between attacks, or an extra
+ * attack made sense for it, so some are unchanged here and only get more variety in what they're mixed in with.
+ *
+ *  - More Enemies:  a handful of random encounters and enemy groups gain lore-appropriate variety (extra enemy
+ *                   types mixed into existing spawn groups, using only actors that already exist in that area).
+ *  - Tougher Enemies: per-enemy HP/attack tweaks, see each actor file for specifics. Never touches vanilla
+ *                   windup / recovery timing, only idle downtime and, where noted, HP or hit counts.
+ *
+ * Both toggles are on by default.
+ */
+
+#include "global.h"
+#include <libultraship/bridge/consolevariablebridge.h>
+
+#define EO_CVAR_VARIETY "gEnhancements.EnemyOverhaul.MoreEnemies"
+#define EO_CVAR_TOUGHER "gEnhancements.EnemyOverhaul.TougherEnemies"
+
+#define EO_VARIETY_ENABLED() (CVarGetInteger(EO_CVAR_VARIETY, 1) != 0)
+#define EO_TOUGHER_ENABLED() (CVarGetInteger(EO_CVAR_TOUGHER, 1) != 0)
+
+// Scales a vanilla health/threshold constant by a custom per-enemy multiplier (as a percentage, e.g. 150 = 1.5x).
+#define EO_HP_PCT(vanilla, pct) (EO_TOUGHER_ENABLED() ? (((vanilla) * (pct)) / 100) : (vanilla))
+
+#endif // ENEMY_OVERHAUL_H
diff --git a/mm/2s2h/Enhancements/MinibossOverhaul/MinibossOverhaul.h b/mm/2s2h/Enhancements/MinibossOverhaul/MinibossOverhaul.h
new file mode 100644
index 000000000..49c1817cb
--- /dev/null
+++ b/mm/2s2h/Enhancements/MinibossOverhaul/MinibossOverhaul.h
@@ -0,0 +1,38 @@
+#ifndef MINIBOSS_OVERHAUL_H
+#define MINIBOSS_OVERHAUL_H
+
+/**
+ * Miniboss Overhaul (Enhancements > Difficulty Options > Miniboss Overhaul)
+ *
+ * Same idea as Boss Overhaul, extended to the game's minibosses: Gekko & Snapper, Wart, Iron Knuckle (both the
+ * miniboss encounters and the ones that guard hallways), Igos du Ikana and his Lackeys, Garo Master, Gomess, and
+ * Eyegore. No new objects, textures or animations: every new attack reuses BossOverhaul's shared orb projectile
+ * (see BossOverhaul.h) or the miniboss' own vanilla actors and effects.
+ *
+ *  - Miniboss HP:   every miniboss above, Eyegore included, has twice its health. Damage dealt by the player is
+ *                    unchanged.
+ *  - Extra Attacks: new attacks built from vanilla actors, effects and sounds for every miniboss above, Eyegore
+ *                    included; vanilla windup / recovery timing is never shortened, only the idle downtime between
+ *                    attacks.
+ *  - Deep Python:   the eels in Pinnacle Rock actively hunt Link near their hole instead of only biting whatever
+ *                    swims directly into them.
+ *
+ * All three toggles are on by default and are read while the fight runs.
+ */
+
+#include "global.h"
+#include "2s2h/Enhancements/BossOverhaul/BossOverhaul.h"
+#include <libultraship/bridge/consolevariablebridge.h>
+
+#define MO_CVAR_HP "gEnhancements.MinibossOverhaul.MinibossHP"
+#define MO_CVAR_ATTACKS "gEnhancements.MinibossOverhaul.ExtraAttacks"
+#define MO_CVAR_DEEP_PYTHON "gEnhancements.MinibossOverhaul.DeepPythonActive"
+
+#define MO_HP_ENABLED() (CVarGetInteger(MO_CVAR_HP, 1) != 0)
+#define MO_ATTACKS_ENABLED() (CVarGetInteger(MO_CVAR_ATTACKS, 1) != 0)
+#define MO_DEEP_PYTHON_ENABLED() (CVarGetInteger(MO_CVAR_DEEP_PYTHON, 1) != 0)
+
+// Scales a vanilla health constant (or a threshold compared against health) for a miniboss: 2x.
+#define MO_HP(vanilla) (MO_HP_ENABLED() ? ((vanilla) * 2) : (vanilla))
+
+#endif // MINIBOSS_OVERHAUL_H
