+/**
+ * Boss Overhaul: a long-range stream of fire breathed from the head while Twinmold flies. The stream tracks Link with a
+ * lag, so it sweeps towards him instead of snapping onto him: run across it, or hide behind a ruin (the fireballs burst
+ * on any wall or floor they touch). Once one head is dead, the survivor's breath lasts longer and fans into three jets.
+ */
+void Boss02_BoFireBreath(Boss02* this, PlayState* play) {
+    Player* player = GET_PLAYER(play);
+    Vec3f forward;
+    Vec3f mouthPos;
+    Vec3f velocity;
+    Vec3f toPlayer;
+    f32 dist;
+    s32 enraged = (this->unk_0195 != 0);
+
+    if (!BO_ATTACKS_ENABLED() || (this->unk_0144 >= 20)) {
+        this->boBreathTimer = 0;
+        return;
+    }
+
+    forward.x = Math_SinS(this->actor.world.rot.y) * Math_CosS(this->actor.world.rot.x);
+    forward.y = Math_SinS(this->actor.world.rot.x);
+    forward.z = Math_CosS(this->actor.world.rot.y) * Math_CosS(this->actor.world.rot.x);
+
+    mouthPos.x = this->actor.world.pos.x + (forward.x * 150.0f * sGiantModeScaleFactor);
+    mouthPos.y = this->actor.world.pos.y + (forward.y * 150.0f * sGiantModeScaleFactor);
+    mouthPos.z = this->actor.world.pos.z + (forward.z * 150.0f * sGiantModeScaleFactor);
+
+    if (this->boBreathTimer > 0) {
+        Vec3f target;
+
+        this->boBreathTimer--;
+
+        // The aim point chases Link at a limited speed
+        target.x = player->actor.world.pos.x;
+        target.y = player->actor.world.pos.y + (30.0f * sGiantModeScaleFactor);
+        target.z = player->actor.world.pos.z;
+        Math_ApproachF(&this->boBreathTarget.x, target.x, 1.0f, 45.0f * sGiantModeScaleFactor);
+        Math_ApproachF(&this->boBreathTarget.y, target.y, 1.0f, 45.0f * sGiantModeScaleFactor);
+        Math_ApproachF(&this->boBreathTarget.z, target.z, 1.0f, 45.0f * sGiantModeScaleFactor);
+
+        Actor_PlaySfx(&this->actor, NA_SE_EV_BURN_OUT - SFX_FLAG);
+
+        if ((this->boBreathTimer % (enraged ? 3 : 2)) == 0) {
+            BoOrb_AimVelocity(&mouthPos, &this->boBreathTarget, 70.0f * sGiantModeScaleFactor, 0, &velocity);
+            Boss02_BoSpawnFireball(play, &mouthPos, &velocity, 0.0f, 40);
+
+            if (enraged) {
+                BoOrb_AimVelocity(&mouthPos, &this->boBreathTarget, 70.0f * sGiantModeScaleFactor, 0x700, &velocity);
+                Boss02_BoSpawnFireball(play, &mouthPos, &velocity, 0.0f, 40);
+                BoOrb_AimVelocity(&mouthPos, &this->boBreathTarget, 70.0f * sGiantModeScaleFactor, -0x700, &velocity);
+                Boss02_BoSpawnFireball(play, &mouthPos, &velocity, 0.0f, 40);
+            }
+        }
+
+        if (this->boBreathTimer == 0) {
+            this->boBreathCooldown = (s16)(Rand_ZeroFloat(80.0f) + 220.0f);
+        }
+        return;
+    }
+
+    if (this->boBreathCooldown > 0) {
+        this->boBreathCooldown--;
+        return;
+    }
+
+    // Only out of the sand: rising (1), flying across the arena (2) or chasing Link (5)
+    if ((this->unk_0144 != 1) && (this->unk_0144 != 2) && (this->unk_0144 != 5)) {
+        return;
+    }
+
+    {
+        CollisionPoly* poly;
+        Vec3f probe = this->actor.world.pos;
+        f32 groundY;
+
+        probe.y = sIsInGiantMode ? 5000.0f : 2000.0f;
+        groundY = BgCheck_EntityRaycastFloor1(&play->colCtx, &poly, &probe);
+
+        if (this->actor.world.pos.y < (groundY + (200.0f * sGiantModeScaleFactor))) {
+            return;
+        }
+    }
+
+    toPlayer.x = player->actor.world.pos.x - mouthPos.x;
+    toPlayer.y = player->actor.world.pos.y - mouthPos.y;
+    toPlayer.z = player->actor.world.pos.z - mouthPos.z;
+    dist = sqrtf(SQ(toPlayer.x) + SQ(toPlayer.y) + SQ(toPlayer.z));
+
+    if ((dist < (300.0f * sGiantModeScaleFactor)) || (dist > (3500.0f * sGiantModeScaleFactor))) {
+        return;
+    }
+
+    // Link has to be roughly in front of the head
+    if (((forward.x * toPlayer.x) + (forward.y * toPlayer.y) + (forward.z * toPlayer.z)) < (0.35f * dist)) {
+        return;
+    }
+
+    this->boBreathTimer = enraged ? 72 : 50;
+    this->boBreathTarget = mouthPos;
+    this->boBreathTarget.x += forward.x * dist;
+    this->boBreathTarget.y += forward.y * dist;
+    this->boBreathTarget.z += forward.z * dist;
+    Actor_PlaySfx(&this->actor, NA_SE_EN_INBOSS_ROAR_OLD);
+}
