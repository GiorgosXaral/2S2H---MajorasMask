+s32 EnHorse_EcoEnabled(void) {
+    return CVarGetInteger(ECO_CVAR("Enabled"), 1) != 0;
+}
+
+s32 EnHorse_EcoFreeform(PlayState* play) {
+    s32 mode;
+
+    if (!EnHorse_EcoEnabled()) {
+        return false;
+    }
+
