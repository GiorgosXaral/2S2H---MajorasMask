+void Boss02_BoEruption(Boss02* this, PlayState* play, Vec3f* breachPos) {
+    Vec3f from;
+    Vec3f to;
+    Vec3f velocity;
+    s32 i;
+    s32 count;
+    s16 baseYaw;
