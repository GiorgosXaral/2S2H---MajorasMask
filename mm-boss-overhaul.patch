+        s16 yaw = baseYaw + (i * (0x10000 / count));
+
+        to.x = breachPos->x + (Math_SinS(yaw) * radius);
+        to.y = breachPos->y;
+        to.z = breachPos->z + (Math_CosS(yaw) * radius);
+        BoOrb_ArcVelocity(&from, &to, 40.0f, -1.0f * sGiantModeScaleFactor, &velocity);
+        Boss02_BoSpawnFireball(play, &from, &velocity, -1.0f * sGiantModeScaleFactor, 60);
+    }
+
+    this->boEruptCooldown = 150;
 }
 
