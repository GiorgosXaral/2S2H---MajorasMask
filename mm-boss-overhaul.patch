+
+    if (mode == ENHORSE_ECO_HYBRID) {
+        // PLAYER_STATE1_100000: first person (aiming the bow / looking around)
+        return !(GET_PLAYER(play)->stateFlags1 & PLAYER_STATE1_100000);
+    }
+
+    return mode == ENHORSE_ECO_FREEFORM;
+}
