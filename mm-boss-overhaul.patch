+        target.y = player->actor.world.pos.y + (30.0f * sGiantModeScaleFactor);
+        target.z = player->actor.world.pos.z;
+        Math_ApproachF(&this->boBreathTarget.x, target.x, 1.0f, 45.0f * sGiantModeScaleFactor);
+        Math_ApproachF(&this->boBreathTarget.y, target.y, 1.0f, 45.0f * sGiantModeScaleFactor);
+        Math_ApproachF(&this->boBreathTarget.z, target.z, 1.0f, 45.0f * sGiantModeScaleFactor);
+
+        Actor_PlaySfx(&this->actor, NA_SE_EV_BURN_OUT - SFX_FLAG);
+
+        if ((this->boBreathTimer % (enraged ? 3 : 2)) == 0) {
+            BoOrb_AimVelocity(&mouthPos, &this->boBreathTarget, 70.0f * sGiantModeScaleFactor, 0, &velocity);
