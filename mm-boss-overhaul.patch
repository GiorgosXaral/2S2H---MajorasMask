+// True while a Remains actor is flying around (not dead or dying).
+s32 Boss07_BoRemainsAlive(Boss07* remains) {
+    if (remains == NULL) {
+        return false;
+    }
+
+    if (remains->actionFunc == Boss07_Remains_Stunned) {
+        return true;
